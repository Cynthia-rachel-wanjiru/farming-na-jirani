{
  "imports": {
    "hono": "npm:hono@4.13.14",
    "hono/": "npm:/hono@4.13.14/",
    "zod": "npm:zod@3.25.76",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.49.8"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "tasks": {
    "check": "deno check index.ts",
    "test": "deno test --allow-env --allow-net tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
